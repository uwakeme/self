<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 通知（提醒）。调度走 WorkManager（持久化 + 自带重启重排），
         不需要精确闹钟 / 开机广播权限。
         照片选取走系统 Photo Picker（PickVisualMedia），不需要任何媒体读取权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 生物识别 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!--
      allowBackup=false：人物档案在 DB 里是明文（姓名、生日、私人笔记、愿望清单、互动记录），
      而应用又自带生物识别应用锁，等于产品自己声明这些数据敏感。不应再默认进 Google 云备份。
      代价是换手机/平板完全靠应用内「设置 → 数据管理 → 导出备份」生成 zip，换机前务必先导。
      注意 allowBackup=false 同时禁用云备份与设备到设备传输，
      所以下面这两个引用（backup_rules / data_extraction_rules）当前都不生效，保留仅为将来恢复时不用重写白名单。
    -->
    <application
        android:name=".SelfApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:ignore="ImageContrastCheck"
        android:supportsRtl="true"
        android:theme="@style/Theme.SelfProfile"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SelfProfile.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面「近期提醒」小组件 -->
        <receiver
            android:name=".widget.RecentWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_widget_info" />
        </receiver>

        <!-- WorkManager + Hilt -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
